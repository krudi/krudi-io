{
    "version": 1,
    "project": {
        "name": "krudi-io",
        "description": "Personal portfolio website \u2014 projects, experiments, blog via GraphQL CMS",
        "type": "nextjs",
        "status": "active"
    },
    "stack": {
        "language": "typescript",
        "framework": "nextjs",
        "frameworkVersion": "16",
        "runtime": "node",
        "packageManager": "npm",
        "ui": "tailwind",
        "graphql": "apollo-client"
    },
    "ports": {
        "dev": 3000
    },
    "commands": {
        "dev": "npm run dev",
        "build": "npm run build",
        "lint": "npm run lint",
        "typecheck": "npm run typecheck"
    },
    "integrations": {
        "graphql": "apollo-client",
        "sharedConfigs": "@krudi/eslint-config, @krudi/typescript-config, @krudi/prettier-config, @krudi/stylelint-config"
    },
    "docs": {
        "agentsFile": "AGENTS.md",
        "claudeFile": "CLAUDE.md",
        "rules": ".ai/rules/nextjs.md",
        "lessons": ".ai/memory/lessons.md"
    },
    "envTemplate": "env-example"
}
