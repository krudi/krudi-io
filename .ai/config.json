{
    "version": 1,
    "project": {
        "name": "krudi-io",
        "description": "Personal portfolio website \u2014 projects and GitHub activity via GitHub's public GraphQL API",
        "type": "nextjs",
        "status": "active"
    },
    "stack": {
        "language": "typescript",
        "framework": "nextjs",
        "frameworkVersion": "16",
        "runtime": "node",
        "packageManager": "npm",
        "ui": "hand-rolled-css",
        "graphql": "fetch"
    },
    "ports": {
        "dev": 3000
    },
    "commands": {
        "dev": "npm run dev",
        "build": "npm run build",
        "lint": "npm run lint",
        "typecheck": "npm run typecheck"
    },
    "docs": {
        "agentsFile": "AGENTS.md",
        "claudeFile": "CLAUDE.md",
        "rules": ".ai/rules/nextjs.md",
        "lessons": ".ai/memory/lessons.md"
    },
    "envTemplate": ".env.example"
}
