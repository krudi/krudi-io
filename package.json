{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "krudi-io",
    "version": "0.1.0",
    "private": false,
    "description": "Personal portfolio website built with Next.js and React, featuring projects and experiments in modern web interfaces.",
    "keywords": [
        "react",
        "nextjs",
        "typescript",
        "javascript",
        "frontend",
        "full-stack",
        "portfolio",
        "web-developer",
        "software-engineer",
        "design-systems",
        "cms",
        "accessibility",
        "performance",
        "ui"
    ],
    "homepage": "https://github.com/krudi/krudi-io#readme",
    "bugs": {
        "url": "https://github.com/krudi/krudi-io/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/krudi/krudi-io.git"
    },
    "license": "MIT",
    "author": {
        "name": "krudi",
        "email": "patryk.kudlik@gmail.com",
        "url": "https://github.com/krudi"
    },
    "type": "module",
    "scripts": {
        "build": "next build",
        "dev": "next dev",
        "dev:turbo": "next dev --turbo",
        "clean": "rm -rf .cache node_modules dist",
        "lint:eslint": "eslint . --cache --cache-location .cache/.eslintcache",
        "lint:eslint:fix": "eslint . --fix --cache --cache-location .cache/.eslintcache",
        "lint:prettier": "prettier --check . --cache --cache-strategy metadata --cache-location .cache/.prettiercache",
        "lint:prettier:fix": "prettier --write . --cache --cache-strategy metadata --cache-location .cache/.prettiercache",
        "lint:stylelint": "stylelint --cache --cache-location .cache/.stylelintcache -c ./stylelint.config.mjs **/*.css",
        "lint:stylelint:fix": "stylelint --cache --cache-location .cache/.stylelintcache -c ./stylelint.config.mjs --fix **/*.css",
        "start": "next start",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@apollo/client": "^4.1.0",
        "@socialgouv/matomo-next": "^1.11.0",
        "@vercel/analytics": "^1.6.1",
        "graphql": "^16.12.0",
        "lucide-react": "^0.562.0",
        "next": "^16.1.1",
        "react": "^19.2.1",
        "react-dom": "^19.2.3"
    },
    "devDependencies": {
        "@babel/preset-react": "^7.28.5",
        "@krudi/eslint-config": "^0.1.8",
        "@krudi/prettier-config": "^0.1.8",
        "@krudi/stylelint-config": "^0.1.1",
        "@krudi/typescript-config": "^0.1.9",
        "@types/node": "^24.10.9",
        "@types/react": "^19.2.8",
        "@types/react-dom": "^19.2.3",
        "autoprefixer": "^10.4.23",
        "postcss": "^8.5.6",
        "postcss-import": "^16.1.1",
        "postcss-load-config": "^6.0.1",
        "postcss-nesting": "^13.0.2",
        "postcss-syntax": "^0.36.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    },
    "packageManager": "npm@11.6.4",
    "engines": {
        "node": ">= 22.18.0",
        "npm": ">= 11.6.4"
    }
}
