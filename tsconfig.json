{
    "extends": "@krudi/typescript-config/nextjs.json",
    "compilerOptions": {
        "paths": {
            "@/*": ["./src/*"],
            "@components/*": ["./src/components/*"],
            "@app/*": ["./src/app/*"],
            "@styles/*": ["./src/styles/*"],
            "@types/*": ["./src/types/*"],
            "@graphql/*": ["./src/graphql/*"],
            "@lib/*": ["./src/lib/*"]
        }
    },
    "include": [
        "next-env.d.ts",
        "src/app/**/*.ts",
        "src/app/**/*.tsx",
        "src/components/**/*.tsx",
        "src/types/**/*.ts",
        "client.d.ts",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts"
    ],
    "exclude": ["node_modules"]
}
